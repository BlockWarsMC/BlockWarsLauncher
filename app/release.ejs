<dialog id="releaseDialog" closedby="none" aria-labelledby="releaseTitle" aria-describedby="releaseDescription releaseMessage">
    <h1 id="releaseTitle"></h1>
    <p id="releaseDescription" role="status"></p>
    <p id="releaseMessage"></p>
    <div class="releaseActions">
        <button id="releaseRetry" type="button" hidden></button>
        <button id="releaseClose" type="button"></button>
    </div>
</dialog>
<aside id="releaseNotice" aria-labelledby="releaseNoticeTitle" hidden>
    <div role="status">
        <h2 id="releaseNoticeTitle"></h2>
        <p id="releaseNoticeVersions"></p>
        <p id="releaseNoticeMessage"></p>
    </div>
    <button id="releaseNoticeDismiss" type="button"></button>
</aside>
